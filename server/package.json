{
  "name": "pp-qa-server",
  "version": "1.0.0",
  "description": "Backend API & Test Engine for Power Platform & Copilot QA",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --runInBand --forceExit",
    "test:parser": "jest tests/parser.test.ts --runInBand",
    "test:byok": "jest tests/byok.test.ts --runInBand",
    "db:migrate": "tsx src/db/migrate.ts",
    "playwright:install": "playwright install chromium",
    "auth:capture": "tsx src/scripts/captureAuthSession.ts"
  },
  "dependencies": {
    "@azure/msal-node": "^2.16.2",
    "@google/genai": "^2.30.0",
    "adm-zip": "^0.5.16",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.79.0",
    "pg": "^8.13.1",
    "pg-mem": "^3.0.14",
    "playwright": "^1.50.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/adm-zip": "^0.5.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.14",
    "@types/pg": "^8.11.11",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL with fallback to in-memory/SQLite if unavailable)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ppqa

# Encryption and JWT Secrets (32-byte hex for AES-256-GCM)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=super-secret-pp-qa-jwt-token-key-change-in-production

# Microsoft Entra ID / Dataverse Default (Optional - can be configured in UI)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_ENVIRONMENT_URL=

# Headless Playwright Authentication Credentials (Optional - can also capture via interactive UI)
MS_AUTH_EMAIL=
MS_USER_PASSWORD=

# BYOK Default API Keys (Optional - can be entered in UI)
OPENAI_API_KEY=
GEMINI_API_KEY=

